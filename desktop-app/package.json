{
  "name": "vsteps-desktop",
  "version": "2.2.0",
  "description": "VSteps Desktop - Control your PC keyboard by walking in place with WebRTC P2P",
  "main": "src/main.js",
  "author": "VSteps",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "@roamhq/wrtc": "^0.8.0",
    "bonjour-service": "^1.2.1",
    "electron-store": "^8.1.0",
    "qrcode": "^1.5.3",
    "socket.io-client": "^4.7.2",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.vsteps.desktop",
    "productName": "VSteps Desktop",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/@roamhq/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/**/prebuilds/!(${platform}-${arch})/**/*"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "perMachine": false,
      "allowElevation": true
    }
  }
}
